/*
 * Converted from cornix20260713.vil for hitsmaxft/zmk-keyboard-cornix.
 *
 * Conversion goals:
 * - Preserve the six Vial layers that are actually reachable/useful.
 * - Preserve tap/hold/double-tap/tap-hold behaviors using native ZMK
 *   hold-tap + tap-dance composition.
 * - Preserve the 20 Vial combos using Cornix physical key positions.
 * - Preserve the two encoder functions from Vial layer 0.
 * - Preserve non-sensitive Vial macros.
 *
 * Deliberate differences:
 * - The credential-like Vial macro M7 is NOT copied into firmware.
 * - QMK KC_ACL0/KC_ACL1 have no direct ZMK keycode equivalent here;
 *   those two utility-layer positions are left as &none.
 * - Vial DF(0)/DF(1) are mapped to &to BASE / &to WINDOWS. This changes
 *   the active base mode but does not persist it across a reboot.
 * - Vial layers 6-9 are omitted because the saved keymap has no path to
 *   activate them; they only contained mostly-empty bindings/encoder data.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE       0
#define WINDOWS    1
#define FN_MAC     2
#define FN_WIN     3
#define SYMBOLS    4
#define MOUSE      5

#define VIAL_TAPPING_TERM 250
#define COMBO_TERM 50
#define MOD_COMBO_PRIOR_IDLE 100
#define CONTROL_COMBO_PRIOR_IDLE 200

/ {
    macros {
        macro_wn: macro_wn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp W &kp N &kp ENTER>;
        };

        macro_hold_rgui: macro_hold_rgui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp RGUI>
                ;
        };

        profile_0_base: profile_0_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to BASE>;
        };

        profile_1_windows: profile_1_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to WINDOWS>;
        };

        profile_2_base: profile_2_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to BASE>;
        };

        macro_sub: macro_sub {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp PRCNT &kp S &kp ENTER>;
        };

        macro_glove80: macro_glove80 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LS(T) &kp Y &kp P &kp E &kp D &kp SPACE
                &kp O &kp N &kp SPACE &kp A &kp SPACE
                &kp LS(G) &kp L &kp O &kp V &kp E &kp N8 &kp N0
            >;
        };

        macro_textblade: macro_textblade {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LS(T) &kp Y &kp P &kp E &kp D &kp SPACE
                &kp O &kp N &kp SPACE &kp A &kp SPACE
                &kp LS(T) &kp E &kp X &kp T &kp LS(B) &kp L &kp A &kp D &kp E &kp EXCL
            >;
        };

        macro_shtuoi: macro_shtuoi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp T &kp U &kp O &kp I>;
        };

        macro_email_work: macro_email_work {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp T &kp A &kp Y &kp L &kp O &kp R &kp AT
                &kp M &kp S &kp O &kp E &kp DOT &kp E &kp D &kp U
            >;
        };

        macro_email_personal: macro_email_personal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp C &kp H &kp R &kp I &kp S &kp AT
                &kp T &kp A &kp Y &kp L &kp O &kp R &kp I &kp A &kp L
                &kp DOT &kp C &kp O &kp M
            >;
        };
    };

    behaviors {
        vmt: vial_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&kp>, <&kp>;
        };

        vlt: vial_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&mo>, <&kp>;
        };

        vkp: vial_key_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&kp>, <&kp>;
        };

        td_vim_single: td_vim_single {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "hold-preferred";
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&macro_hold_rgui>, <&macro_wn>;
        };

        td_ralt_second: td_ralt_second {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "hold-preferred";
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&macro_shtuoi>, <&none>;
        };

        td_ctrl_arrows: tap_dance_ctrl_arrows {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vmt LCTRL LC(RIGHT)>, <&kp LC(LEFT)>;
        };

        td_gui_grave: tap_dance_gui_grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vmt LGUI LG(GRAVE)>, <&kp LS(LG(GRAVE))>;
        };

        td_app_switch: tap_dance_app_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vmt LALT LG(TAB)>, <&kp LS(LG(TAB))>;
        };

        td_mac_edit: tap_dance_mac_edit {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            /* tap=paste, hold=GUI, double-tap=copy, tap+hold=cut */
            bindings = <&vmt LGUI LG(V)>, <&vkp LG(X) LG(C)>;
        };

        td_tab_switch: tap_dance_tab_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vlt FN_MAC LC(TAB)>, <&kp LC(LS(TAB))>;
        };

        td_mac_undo: tap_dance_mac_undo {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vmt RCTRL LG(Z)>, <&kp LS(LG(Z))>;
        };

        td_vim: tap_dance_vim {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&td_vim_single>, <&macro_sub>;
        };

        td_ralt_macro: tap_dance_ralt_macro {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            /* tap=Shift+GUI+C, hold=RALT, double-tap=none, tap+hold=macro_shtuoi */
            bindings = <&vmt RALT LS(LG(C))>, <&td_ralt_second>;
        };

        td_win_edit: tap_dance_win_edit {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <VIAL_TAPPING_TERM>;
            bindings = <&vmt LCTRL LC(V)>, <&kp LC(C)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_rt_profile0 {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <CONTROL_COMBO_PRIOR_IDLE>;
            key-positions = <4 5>;
            bindings = <&profile_0_base>;
        };

        combo_er_profile1 {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <CONTROL_COMBO_PRIOR_IDLE>;
            key-positions = <3 4>;
            bindings = <&profile_1_windows>;
        };

        combo_we_profile2 {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <CONTROL_COMBO_PRIOR_IDLE>;
            key-positions = <2 3>;
            bindings = <&profile_2_base>;
        };

        combo_yu_output_toggle {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <CONTROL_COMBO_PRIOR_IDLE>;
            key-positions = <6 7>;
            bindings = <&out OUT_TOG>;
        };

        combo_fd_fnmac {
            timeout-ms = <COMBO_TERM>;
            key-positions = <16 15>;
            layers = <BASE WINDOWS>;
            bindings = <&mo FN_MAC>;
        };

        combo_jk_fnmac {
            timeout-ms = <COMBO_TERM>;
            key-positions = <19 20>;
            layers = <BASE WINDOWS>;
            bindings = <&mo FN_MAC>;
        };

        combo_gf_fnwin {
            timeout-ms = <COMBO_TERM>;
            key-positions = <17 16>;
            layers = <BASE WINDOWS>;
            bindings = <&mo FN_WIN>;
        };

        combo_kl_symbols {
            timeout-ms = <COMBO_TERM>;
            key-positions = <20 21>;
            layers = <BASE WINDOWS SYMBOLS>;
            bindings = <&tog SYMBOLS>;
        };

        combo_cv_lgui {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <27 28>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LGUI>;
        };

        combo_mcomma_rgui {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <33 34>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RGUI>;
        };

        combo_xc_lalt {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <26 27>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LALT>;
        };

        combo_commadot_ralt {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <34 35>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RALT>;
        };

        combo_zx_lctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <25 26>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LCTRL>;
        };

        combo_dotslash_rctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <35 36>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RCTRL>;
        };

        combo_xcv_lgui_lalt {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <26 27 28>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LG(LALT)>;
        };

        combo_mcommadot_rgui_ralt {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <33 34 35>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RG(RALT)>;
        };

        combo_zv_lgui_lctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <25 28>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LG(LCTRL)>;
        };

        combo_mslash_rgui_rctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <33 36>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RG(RCTRL)>;
        };

        combo_zxcv_lcagui {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <25 26 27 28>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LC(LA(LGUI))>;
        };

        combo_mcds_rcgalt {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <33 34 35 36>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RC(RG(RALT))>;
        };

        combo_zxc_lalt_lctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <25 26 27>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LA(LCTRL)>;
        };

        combo_cds_ralt_rctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <34 35 36>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RA(RCTRL)>;
        };

        combo_vb_lctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <28 29>;
            layers = <BASE WINDOWS>;
            bindings = <&kp LCTRL>;
        };

        combo_nm_rctrl {
            timeout-ms = <COMBO_TERM>;
            require-prior-idle-ms = <MOD_COMBO_PRIOR_IDLE>;
            key-positions = <32 33>;
            layers = <BASE WINDOWS>;
            bindings = <&kp RCTRL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SQT  &kp ENTER
                &kp LS(MINUS)  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_PLAY_PAUSE  &tog MOUSE  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                &td_ctrl_arrows  &td_gui_grave  &td_app_switch  &vlt SYMBOLS LA(SPACE)  &kp LSHIFT  &td_mac_edit  &vmt RGUI BSPC  &vlt SYMBOLS SPACE  &td_tab_switch  &td_mac_undo  &td_vim  &td_ralt_macro
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        windows_layer {
            display-name = "Windows";
            /*
             * Windows is an overlay on Base. Only bindings that differ from
             * Base are specified here; everything else falls through.
             */
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &vmt LGUI X  &vmt LALT C  &vmt LCTRL V  &trans  &to BASE  &trans  &trans  &vmt RCTRL M  &vmt RALT DOT  &vmt RGUI DOT  &trans  &trans
                &kp LCTRL  &kp LGUI  &kp LALT  &trans  &trans  &td_win_edit  &vmt LCTRL BSPC  &trans  &kp RA(TAB)  &kp RALT  &kp RGUI  &kp RCTRL
            >;
        };

        mac_fn_layer {
            display-name = "Mac Fn";
            bindings = <
                &kp LG(Z)  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp LA(LEFT)  &kp END  &kp HOME  &kp LA(RIGHT)  &kp PG_UP  &kp LC(LG(SPACE))
                &kp LS(LG(Z))  &kp F14  &kp LSHIFT  &kp F11  &kp F12  &kp F13  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp LG(X)  &trans
                &macro_shtuoi  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &trans  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(UP)  &kp LG(RIGHT)  &kp PG_DN  &macro_textblade
                &macro_email_work  &macro_email_personal  &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        windows_fn_layer {
            display-name = "Windows Fn";
            bindings = <
                &kp LC(Z)  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp LC(LEFT)  &kp LC(END)  &kp LC(HOME)  &kp LC(RIGHT)  &kp PG_UP  &kp LG(DOT)
                &kp LC(Y)  &kp F14  &kp LSHIFT  &kp LSHIFT  &kp F12  &kp F13  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp LC(X)  &trans
                &macro_shtuoi  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans  &trans  &kp HOME  &kp LC(DOWN)  &kp LC(UP)  &kp END  &kp PG_DN  &macro_textblade
                &macro_email_work  &macro_email_personal  &none  &trans  &trans  &trans  &trans  &trans  &trans  &macro_wn  &macro_sub  &macro_glove80
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
                &kp LS(GRAVE)  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DELETE
                &kp GRAVE  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp LS(BSLH)
                &kp LS(MINUS)  &kp LS(EQUAL)  &kp MINUS  &kp EQUAL  &kp LS(LBKT)  &kp LS(RBKT)  &trans  &trans  &kp LBKT  &kp RBKT  &kp SEMI  &kp LS(SEMI)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_DOT  &trans  &kp ENTER
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &out OUT_TOG  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &profile_0_base  &none  &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
                &profile_1_windows  &to BASE  &to WINDOWS  &none  &none  &none  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                &profile_2_base  &to BASE  &to WINDOWS  &none  &none  &none  &mkp MB2  &mkp MB1  &mkp MB3  &none  &none  &none
            >;
        };
    };
};
